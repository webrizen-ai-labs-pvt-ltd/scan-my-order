{
  "name": "@smo/backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "prisma generate --schema prisma/schema.prisma && node scripts/check-syntax.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed:venues": "node prisma/seed-venues.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@simplewebauthn/server": "^13.3.2",
    "@smo/shared": "*",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "google-auth-library": "^10.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "9.0.5",
    "pg": "^8.16.3",
    "prisma": "6.12.0",
    "razorpay": "^2.9.8",
    "web-push": "^3.6.7"
  }
}
