generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma_v2"
  // Lets hot queries load their relations in one SQL query (relationLoadStrategy: "join")
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

// How guests order: at tables (waiters, table QR codes) or at a counter (takeaway, prepaid, pickup numbers)
enum StoreServiceMode {
  TABLES
  COUNTER
}

// A mall, food court or cinema: counters from different brands behind one QR code
model Venue {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String?
  address     String?
  description String?
  coverImage  String?
  isActive    Boolean  @default(true)
  stores      Store[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pickup numbers (#1, #2…) for counter orders, restarting every day per store
model StorePickupCounter {
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD in India time
  last    Int    @default(0)

  @@id([storeId, day])
}

// A guest who ordered with a phone number (no account); one row per number
model GuestContact {
  id          String   @id @default(cuid())
  phone       String   @unique // 10-digit Indian mobile, normalised
  name        String?
  ordersCount Int      @default(0)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  orders      Order[]
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  STORE_MANAGER
  WAITER
  CASHIER
  KITCHEN_STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
  DELETED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PaymentProvider {
  RAZORPAY
}

enum UnitOfMeasure {
  KG
  GRAM
  LITER
  MILLILITER
  PIECE
  DOZEN
}

enum DietaryPreference {
  VEG
  NON_VEG
  VEGAN
  EGG
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum TransactionType {
  RESTOCK
  CONSUME
  ADJUST
}

enum OrderOrigin {
  QR_MENU
  POS
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentModel {
  PREPAID
  POSTPAID
}

enum PaymentMethod {
  CASH
  ONLINE
  SPLIT
  DUES // closed on credit; the money is owed by a dues account (e.g. the owner)
}

// How a single tender line was collected
enum PaymentChannel {
  RAZORPAY     // Razorpay QR code, payment link or checkout; verified with the gateway
  UPI_OFFLINE  // Store's own UPI ID, confirmed manually by staff
  CASH
  DUES         // Bill put on dues: owed by a dues account, paid back later
}

// How money owed on dues came in
enum DuesRepaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_PAYMENT
  PROCESSING
  READY
  SERVED
  SETTLED
  CANCELLED
}

enum RefundStatus {
  PENDING   // Razorpay accepted the refund; money is on its way
  PROCESSED // Money returned (Razorpay confirmed, or cash/UPI handed back by staff)
  FAILED    // Razorpay could not refund; the amount is owed again
}

enum OrderItemStatus {
  ACTIVE
  REJECTED // Kitchen couldn't make it; excluded from the bill and inventory
}

enum WaiterCallType {
  WATER
  BILL
  CALL_WAITER
  CUTLERY
  CLEAN_TABLE
}

enum WaiterCallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status           TenantStatus           @default(ACTIVE)
  logo             String?
  brandColor       String?
  description      String?
  gstin            String?
  companyLegalName String?
  registeredAddress String?
  // Default UPI ID for offline (manually confirmed) UPI collection; stores may override
  offlineUpiId        String?
  offlineUpiPayeeName String?
  stores           Store[]
  users            User[]
  subscription     TenantSubscription?
  paymentGateways  TenantPaymentGateway[]
  corporateClients CorporateClient[]
  duesAccounts     DuesAccount[]
  duesRepayments   DuesRepayment[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Store {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  address   String?
  contactPhone String?
  // More numbers guests and staff can call (contactPhone stays the main one)
  extraPhones  String[] @default([])
  contactEmail String?
  // e.g. FSSAI licence or shop registration number; printed on bills
  registrationNumber String?
  operatingHours Json?
  banner    String?
  status    StoreStatus @default(ACTIVE)
  users        User[]
  categories   MenuCategory[]
  menuItems    MenuItem[]
  rawMaterials RawMaterial[]
  tables       Table[]
  tableSessions TableSession[]
  reservations TableReservation[]
  orders       Order[]
  waiterCalls  WaiterCall[]
  waiterPresence WaiterPresence[]
  feedbacks    Feedback[]
  googleReviewUrl String?
  // Overrides Tenant.offlineUpiId for this location when set
  offlineUpiId        String?
  offlineUpiPayeeName String?
  payments            Payment[]
  refunds             Refund[]
  jobConfigs          StoreJobConfig[]
  orderEvents         OrderEvent[]
  invoices            Invoice[]
  duesRepayments      DuesRepayment[]
  invoiceSequences    InvoiceSequence[]
  pickupCounters      StorePickupCounter[]

  serviceMode   StoreServiceMode @default(TABLES)
  venueId       String?
  venue         Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  // Where to find the counter inside the venue, e.g. "3rd floor food court, counter 12"
  venueLocation String?

  // Guest ordering: send UPI orders to the kitchen before staff confirm the money arrived,
  // and (counter stores) let guests order now and pay at the counter
  startBeforeUpiConfirmed Boolean @default(false)
  payAtCounter            Boolean @default(false)

  // Array of { name: string, rate: number } e.g. [{"name": "CGST", "rate": 2.5}]
  taxRules     Json?       @default("[]")
  promoCodes   PromoCode[]
  loyaltyRules Json?       @default("null")
  customerWallets CustomerStoreWallet[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tenantId, slug])
  @@index([venueId])
  @@index([tenantId])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  email        String
  name         String?
  phone        String?
  profilePhoto String?
  passwordHash String?
  // Bumped on password change/reset; login tokens carrying an older value stop working
  tokenVersion Int        @default(0)
  currentChallenge String?
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  passkeys     Passkey[]
  staffOrders    Order[] @relation("StaffOrders")
  customerOrders Order[] @relation("CustomerOrders")
  customerWallets CustomerStoreWallet[] @relation("CustomerWallets")
  resolvedCalls WaiterCall[] @relation("ResolvedCalls")
  assignedCalls WaiterCall[] @relation("AssignedCalls")
  waiterPresence WaiterPresence[]
  reservations TableReservation[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  collectedPayments Payment[] @relation("CollectedPayments")
  cancelledOrders   Order[]   @relation("CancelledOrders")
  recordedDuesRepayments DuesRepayment[] @relation("RecordedDuesRepayments")
  rejectedOrderItems OrderItem[] @relation("RejectedOrderItems")
  processedRefunds  Refund[]    @relation("ProcessedRefunds")
  orderEvents       OrderEvent[] @relation("OrderEventActor")
  issuedInvoices    Invoice[]   @relation("IssuedInvoices")

  @@unique([tenantId, email])
  @@index([role])
  @@index([tenantId, role])
  @@index([storeId, role])
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  price       Int
  currency    String   @default("INR")
  maxStores   Int
  interval    PlanInterval
  isActive    Boolean  @default(true)
  
  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  providerSubId    String?
  gracePeriodEndsAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TenantPaymentGateway {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     PaymentProvider
  merchantId   String
  apiKey       String
  secretKey    String?
  // Encrypted Razorpay webhook secret (optional; payments are also verified by polling)
  webhookSecret String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tenantId, provider])
}

model MenuCategory {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int        @default(0)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([storeId])
}

model MenuItem {
  id                 String            @id @default(cuid())
  storeId            String
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId         String
  category           MenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  price              Int               // Stored in smallest currency unit
  image              String?
  // Optional video of the dish (YouTube, Vimeo, Google Drive or a direct .mp4 link); plays when guests tap the photo
  videoUrl           String?
  dietary            DietaryPreference @default(VEG)
  spiceLevel         SpiceLevel        @default(NONE)
  
  isManuallyDisabled Boolean           @default(false)
  isSystemDisabled   Boolean           @default(false)
  
  recipe             RecipeIngredient[]
  modifierGroups     MenuModifierGroup[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orderItems         OrderItem[]

  @@index([storeId])
  @@index([categoryId])
  @@index([storeId, categoryId])
}

model MenuModifierGroup {
  id            String               @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name          String               
  isRequired    Boolean              @default(false)
  minSelections Int                  @default(0)
  maxSelections Int                  @default(1)
  options       MenuModifierOption[]

  @@index([menuItemId])
}

model MenuModifierOption {
  id            String            @id @default(cuid())
  groupId       String
  group         MenuModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  price         Int               @default(0) 
  recipe        RecipeIngredient[]
  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
}

model RawMaterial {
  id                String             @id @default(cuid())
  storeId           String
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name              String
  unit              UnitOfMeasure
  currentStock      Float              @default(0)
  lowStockThreshold Float              @default(0)
  
  recipes           RecipeIngredient[]
  transactions      StockTransaction[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([storeId])
}

model StockTransaction {
  id            String          @id @default(cuid())
  materialId    String
  material      RawMaterial     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type          TransactionType
  quantity      Float           
  reference     String?         
  createdAt     DateTime        @default(now())
}

model RecipeIngredient {
  id               String              @id @default(cuid())
  rawMaterialId    String
  rawMaterial      RawMaterial         @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  
  menuItemId       String?
  menuItem         MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  modifierOptionId String?
  modifierOption   MenuModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)
  
  quantity         Float               

  // To ensure we don't have duplicates of the same raw material on the same item or option
  @@unique([menuItemId, rawMaterialId])
  @@unique([modifierOptionId, rawMaterialId])
  @@index([rawMaterialId])
  @@index([menuItemId])
  @@index([modifierOptionId])
}

model Table {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableNumber Int
  capacity    Int      @default(4)
  isActive    Boolean  @default(true)
  
  orders       Order[]
  sessions     TableSession[]
  reservations TableReservation[]
  waiterCalls  WaiterCall[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, tableNumber])
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model PromoCode {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String   
  discountType  DiscountType
  discountValue Float    
  minOrderValue Int      @default(0)
  maxDiscount   Int?
  isActive      Boolean  @default(true)
  validUntil    DateTime?
  
  orders        Order[]
  tableSessions TableSession[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([storeId, code])
}

model Order {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  
  origin          OrderOrigin
  type            OrderType
  tableId         String?        
  table           Table?         @relation(fields: [tableId], references: [id])
  tableSessionId  String?
  tableSession    TableSession?  @relation(fields: [tableSessionId], references: [id])
  staffId         String?        
  staff           User?          @relation("StaffOrders", fields: [staffId], references: [id])
  customerId      String?
  customer        User?          @relation("CustomerOrders", fields: [customerId], references: [id])
  sessionId       String?

  paymentModel    PaymentModel
  paymentMethod   PaymentMethod?
  cashAmount      Int            @default(0)
  onlineAmount    Int            @default(0)
  duesAmount      Int            @default(0) // part of the bill put on dues
  // Set once payments cover the bill; a paid order auto-settles when served
  paidAt          DateTime?
  status          OrderStatus    @default(DRAFT)
  
  subTotal        Int            @default(0)
  taxAmount       Int            @default(0)
  discountAmount  Int            @default(0)
  walletDiscount  Int            @default(0)
  promoCodeId     String?
  promoCode       PromoCode?     @relation(fields: [promoCodeId], references: [id])
  totalAmount     Int            @default(0) 
  // Tax rules in force when the order was placed; edits keep using these rates
  taxRules        Json?

  // Money owed back to the guest after the kitchen rejected paid items (cleared by refunds)
  refundDue       Int            @default(0)

  // Corporate details chosen before payment; the invoice is issued with them on settlement
  invoiceRequest  Json?

  // Kitchen timing: when the order was marked ready (enables a short "recall"), and delay minutes announced to the guest
  readyAt         DateTime?
  delayMinutes    Int            @default(0)
  // When the kitchen got it, and when we told the guest it would be ready (moves with announced delays)
  kitchenAt        DateTime?
  estimatedReadyAt DateTime?

  // Counter orders: the number called out at pickup, and who to call
  pickupNumber    Int?
  customerName    String?
  customerPhone   String?
  // How a QR-menu guest chose to pay: ONLINE (Razorpay), UPI (store's own UPI ID) or COUNTER
  guestPayMethod  String?
  guestContactId  String?
  guestContact    GuestContact?  @relation(fields: [guestContactId], references: [id], onDelete: SetNull)

  // Set when staff cancel the order (reason is mandatory)
  cancelReason    String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?          @relation("CancelledOrders", fields: [cancelledById], references: [id], onDelete: SetNull)

  // Set while this order's ingredients are taken from stock; cleared when they're returned.
  // Stock only moves when this flips, so it can never be taken or returned twice.
  stockDeductedAt DateTime?

  // Old cancelled orders are archived (hidden from Order History), never deleted: they're financial records
  archivedAt      DateTime?


  paymentLinkId   String?
  paymentLinkUrl  String?
  
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  events          OrderEvent[]
  invoices        Invoice[]
  feedbacks       Feedback[]
  walletTransactions CustomerWalletTransaction[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([storeId, status])
  @@index([customerId])
  @@index([sessionId])
  @@index([tableSessionId])
  @@index([tableId])
  @@index([guestContactId])
}

// One tender line against an order or a whole table session.
// A bill is settled once the PAID payments cover its total.
model Payment {
  id                String         @id @default(cuid())
  storeId           String
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tableSessionId    String?
  tableSession      TableSession?  @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  channel           PaymentChannel
  status            PaymentStatus  @default(PENDING)
  amount            Int

  // Gateway tracking (RAZORPAY only)
  providerKind      String?        // 'QR_CODE' | 'PAYMENT_LINK' | 'ORDER'
  providerRef       String?        @unique // Razorpay qr_code / payment_link / order id
  providerPaymentId String?        @unique // Razorpay pay_xxx once captured
  qrImageUrl        String?        // Hosted QR image (Razorpay QR codes)
  qrPayload         String?        // String to encode as QR (upi:// intent or link URL)

  refunds           Refund[]

  // Dues (channel DUES): who owes it, who ate, why, and how much has been paid back or reduced
  duesAccountId     String?
  duesAccount       DuesAccount?   @relation(fields: [duesAccountId], references: [id], onDelete: Restrict)
  duesGuest         Json?          // { name, phone, whatsapp, email }
  duesNote          String?
  duesSettled       Int            @default(0) // paid back through dues repayments
  duesReduced       Int            @default(0) // taken off because items weren't served
  duesAllocations   DuesAllocation[]

  // Started by a guest from the QR menu (UPI to the store's own ID): only cashiers and managers confirm it
  fromGuest         Boolean        @default(false)
  // The guest said they paid, with the UPI reference number if they gave it (12 digits)
  guestClaimedAt    DateTime?
  guestReference    String?

  // Cash drawer details
  cashTendered      Int?
  changeDue         Int?

  collectedById     String?
  collectedBy       User?          @relation("CollectedPayments", fields: [collectedById], references: [id], onDelete: SetNull)
  paidAt            DateTime?
  expiresAt         DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orderId])
  @@index([tableSessionId])
  @@index([storeId, status])
  @@index([status, channel])
  @@index([storeId, guestReference])
}

// Money returned to a guest (e.g. the kitchen could not make paid items).
model Refund {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Original payment being refunded (required for Razorpay refunds)
  paymentId        String?
  payment          Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  method           PaymentChannel
  status           RefundStatus   @default(PENDING)
  amount           Int
  reason           String?
  providerRefundId String?        @unique // Razorpay rfnd_xxx
  failureReason    String?

  processedById    String?
  processedBy      User?          @relation("ProcessedRefunds", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([storeId, status])
}

model OrderItem {
  id              String               @id @default(cuid())
  orderId         String
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem             @relation(fields: [menuItemId], references: [id])
  
  quantity        Int                  @default(1)
  kitchenNotes    String?              
  priceAtOrder    Int                  

  status          OrderItemStatus      @default(ACTIVE)
  // Kitchen marked this line ready on its own (e.g. starters before mains)
  readyAt         DateTime?
  rejectReason    String?
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?                @relation("RejectedOrderItems", fields: [rejectedById], references: [id], onDelete: SetNull)
  
  modifiers       OrderItemModifier[]

  @@index([orderId])
  @@index([menuItemId])
}

model OrderItemModifier {
  id               String             @id @default(cuid())
  orderItemId      String
  orderItem        OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId String
  modifierOption   MenuModifierOption @relation(fields: [modifierOptionId], references: [id])
  
  priceAtOrder     Int                

  @@index([orderItemId])
  @@index([modifierOptionId])
}

model WaiterCall {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId     String
  table       Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type        WaiterCallType
  // What the guest typed (optional, max 100 chars)
  note        String?
  status      WaiterCallStatus @default(PENDING)
  resolvedById String?
  resolvedBy  User?            @relation("ResolvedCalls", fields: [resolvedById], references: [id])

  // Dispatch: who is paged now, who was already tried, and when it moves on if nobody answers.
  // Kept here (not in server memory) so a restart or deploy never drops a call.
  assignedWaiterId   String?
  assignedWaiter     User?     @relation("AssignedCalls", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  escalationLevel    Int       @default(0) // 0 first waiter, 1+ passed on, 2 = manager
  attemptedWaiterIds String[]  @default([])
  escalateAt         DateTime? // set while a waiter has 60 s to answer

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([storeId, status])
  @@index([status, escalateAt])
}

enum WaiterAvailability {
  AVAILABLE
  BUSY
}

// A waiter's on-shift state for call dispatch (Busy waiters aren't paged)
model WaiterPresence {
  storeId        String
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         WaiterAvailability @default(AVAILABLE)
  // Last time they finished a call: longer idle waiters are paged first
  lastResolvedAt DateTime?
  updatedAt      DateTime           @updatedAt

  @@id([storeId, userId])
}

model Feedback {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating      Int      
  comment     String?
  isPublic    Boolean  @default(false) 
  createdAt   DateTime @default(now())

  @@index([storeId])
  @@index([orderId])
}

enum TableSessionStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

model TableSession {
  id         String             @id @default(cuid())
  storeId    String
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId    String
  table           Table              @relation(fields: [tableId], references: [id], onDelete: Cascade)
  pin             String             // 4-digit numeric PIN e.g. "4821"
  sessionToken    String?            @unique
  status          TableSessionStatus @default(ACTIVE)
  paymentMethod   PaymentMethod?
  cashAmount      Int?               @default(0)
  onlineAmount    Int?               @default(0)
  duesAmount      Int                @default(0)
  // Corporate details chosen before payment; the invoice is issued with them on settlement
  invoiceRequest  Json?
  // Promo applied to the whole table bill at checkout; its discount is split across the unpaid orders
  promoCodeId     String?
  promoCode       PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  orders          Order[]
  payments        Payment[]
  events          OrderEvent[]
  invoices        Invoice[]

  lastOrderAt     DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([storeId, tableId, status])
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model TableReservation {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId     String
  table       Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  
  guestName   String
  guestPhone  String
  partySize   Int?              @default(2)
  notes       String?
  
  startsAt    DateTime
  endsAt      DateTime
  
  status      ReservationStatus @default(CONFIRMED)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([storeId, status])
  @@index([storeId, startsAt])
  @@index([tableId, startsAt])
}

enum WalletTransactionType {
  WELCOME_BONUS
  ORDER_CASHBACK
  ORDER_REDEMPTION
  ORDER_REFUND
  MANUAL_ADJUSTMENT
  EXPIRED
}

model CustomerStoreWallet {
  id           String                      @id @default(cuid())
  customerId   String
  customer     User                        @relation("CustomerWallets", fields: [customerId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  balance      Float                       @default(0)
  totalEarned  Float                       @default(0)
  totalSpent   Float                       @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  transactions CustomerWalletTransaction[]

  @@unique([customerId, storeId])
  @@index([customerId])
  @@index([storeId])
}

model CustomerWalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  wallet       CustomerStoreWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type         WalletTransactionType
  amount       Float
  balanceAfter Float
  description  String
  createdAt    DateTime              @default(now())

  @@index([walletId])
  @@index([orderId])
}

model PushSubscription {
  id          String    @id @default(cuid())
  endpoint    String    @unique
  p256dh      String
  auth        String
  userType    String    @default("CUSTOMER") // 'CUSTOMER' | 'STAFF'
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?   // For anonymous table QR customers
  role        String?   // 'WAITER' | 'KITCHEN' | 'STORE_MANAGER' | 'CUSTOMER'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId])
  @@index([userId])
  @@index([sessionId])
  @@index([role])
}

model Notification {
  id          String    @id @default(cuid())
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  role        String?
  title       String
  body        String
  type        String    // e.g. 'ORDER_STATUS', 'WAITER_CALL', 'PAYMENT_WEBHOOK', 'KITCHEN_ALERT'
  data        Json?     // additional payload { orderId, tableNumber, url, sound }
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([storeId])
  @@index([userId])
  @@index([sessionId])
  @@index([type])
  @@index([isRead])
}

// Per-store settings and last-run status for scheduled maintenance jobs (see src/jobs/registry.js).
// Kept in the database so settings survive deploys and are shared by every backend instance.
model StoreJobConfig {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobKey            String

  // null = use the job's default from the registry
  enabled           Boolean?
  schedule          String?
  params            Json?

  lastRunAt         DateTime?
  lastRunStatus     String?   // 'SUCCESS' | 'FAILED'
  lastRunSummary    String?
  lastRunDurationMs Int?
  lastRunError      String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, jobKey])
}

// Permanent, append-only audit trail for everything that happens to an order or table bill.
// There is intentionally no API to edit or delete these rows.
model OrderEvent {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  type           String        // e.g. ORDER_CREATED, STATUS_CHANGED, ITEMS_EDITED, PAYMENT_RECEIVED, INVOICE_ISSUED
  source         String        // POS | KDS | WAITER | QR_MENU | SYSTEM | WEBHOOK
  // Who did it, as they were at that moment (kept even if the user later changes or leaves)
  actorId        String?
  actor          User?         @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName      String?
  actorRole      String?
  reason         String?
  amountBefore   Int?
  amountAfter    Int?
  data           Json?         // before/after details
  createdAt      DateTime      @default(now())

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([tableSessionId])
  @@index([actorId])
}

enum InvoiceKind {
  STANDARD    // Regular GST bill (B2C)
  CORPORATE   // Tax invoice billed to a company (B2B), with the company's GSTIN
  CREDIT_NOTE // Reverses all or part of an earlier invoice
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

// Numbered GST documents. Contents are frozen in `snapshot` when issued and never change;
// corrections are made with a credit note and, if needed, a new invoice.
model Invoice {
  id                String        @id @default(cuid())
  storeId           String
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number            String        // e.g. NLCF/25-26/00012 (max 16 chars)
  series            String        // INV | CN
  financialYear     String        // e.g. 25-26 (April–March, IST)
  seq               Int
  kind              InvoiceKind
  status            InvoiceStatus @default(ISSUED)

  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tableSessionId    String?
  tableSession      TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  // Credit notes point at the invoice they reverse; replacement invoices point at the one they replace
  relatedInvoiceId  String?
  relatedInvoice    Invoice?      @relation("InvoiceRelation", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  relatedInvoices   Invoice[]     @relation("InvoiceRelation")

  totalAmount       Int
  taxAmount         Int
  snapshot          Json          // supplier, bill-to, lines, taxes, totals, payments at issue time
  billTo            Json?         // corporate details (name, GSTIN, address, employee, PO…)

  issuedById        String?
  issuedBy          User?         @relation("IssuedInvoices", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt          DateTime      @default(now())
  cancelledAt       DateTime?
  cancelReason      String?
  emailedTo         String?
  emailedAt         DateTime?

  @@unique([storeId, number])
  @@unique([storeId, series, financialYear, seq])
  @@index([storeId, issuedAt])
  @@index([orderId])
  @@index([tableSessionId])
}

// Gap-free counters for invoice numbers, per store, series and financial year
model InvoiceSequence {
  storeId       String
  store         Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  series        String
  financialYear String
  lastSeq       Int    @default(0)

  @@id([storeId, series, financialYear])
}

// Companies a brand regularly bills (saved from the corporate invoice form)
model CorporateClient {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   // Legal name as it should appear on the invoice
  gstin     String?
  address   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, gstin])
  @@index([tenantId, name])
}

// Someone who can owe the brand money for bills put on dues (the owner, a partner, a company…)
model DuesAccount {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  note        String?
  isOwner     Boolean         @default(false) // the brand owner's own account, created automatically
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bills       Payment[]
  repayments  DuesRepayment[]

  @@index([tenantId, isActive])
}

// Money received against an account's dues; split across its bills oldest first
model DuesRepayment {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId    String
  account      DuesAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  storeId      String?             // bills of this store only; null = any store
  store        Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  amount       Int
  method       DuesRepaymentMethod
  reference    String?             // UTR, cheque no., etc.
  note         String?
  receivedAt   DateTime            @default(now())
  recordedById String?
  recordedBy   User?               @relation("RecordedDuesRepayments", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  allocations  DuesAllocation[]

  @@index([tenantId, receivedAt])
  @@index([accountId])
}

// How much of a repayment went to which dues bill
model DuesAllocation {
  id          String        @id @default(cuid())
  repaymentId String
  repayment   DuesRepayment @relation(fields: [repaymentId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Int
  createdAt   DateTime      @default(now())

  @@index([paymentId])
}
