generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  WAITER
  KITCHEN
  CUSTOMER
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
  VEGAN
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String?
  name               String
  avatar             String?
  role               Role      @default(CUSTOMER)
  status             Status    @default(ACTIVE)
  
  // Employer / Employee hierarchy
  ownerId            String?
  owner              User?     @relation("OwnerEmployees", fields: [ownerId], references: [id], onDelete: SetNull)
  employees          User[]    @relation("OwnerEmployees")
  
  // Store relation
  storeId            String?
  store              UserStoreRel? @relation(fields: [storeId], references: [id])
  
  // Auth providers
  googleId           String?   @unique
  resetToken         String?
  resetTokenExpires  DateTime?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  passkeys           Passkey[]
  ownedStores        Store[]   @relation("OwnerStores")
}

model UserStoreRel {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  users     User[]
}

model Passkey {
  id           String   @id @default(uuid())
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Store {
  id                  String    @id @default(uuid())
  slug                String?   @unique
  name                String
  description         String?
  ownerId             String
  owner               User      @relation("OwnerStores", fields: [ownerId], references: [id], onDelete: Cascade)
  colorScheme         String?
  fontStyle           String?
  brandingLogo        String?
  operatingHours      String?

  // Tax & Dynamic Billing Breakdown Configuration
  gstNumber           String?
  taxType             String?   @default("FORWARD") // "FORWARD" (Exclusive) or "BACKWARD" (Inclusive)
  taxValueType        String?   @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  taxValue            Float?    @default(5) // Default 5% GST
  serviceFee          Float?    @default(0) // Platform / Service Fee
  allowManualDiscount Boolean   @default(true)
  couponCode          String?   // e.g. "WELCOME10"
  couponValueType     String?   @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  couponValue         Float?    @default(0) // Coupon discount

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  menuItems           MenuItem[]
  userStoreRels       UserStoreRel[]
  subscriptions       StoreSubscription[]
  tables              Table[]
  orders              Order[]
}

enum OrderType {
  DINING
  TAKEAWAY
}

enum PaymentType {
  PREPAID
  POSTPAID
}

enum OrderStatus {
  PENDING_VERIFICATION
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Table {
  id          String   @id @default(uuid())
  number      String
  name        String?
  capacity    Int      @default(4)
  section     String?  @default("Main Dining")
  status      String   @default("AVAILABLE")
  qrCodeUrl   String?
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, number])
}

model MenuItem {
  id             String      @id @default(uuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Float
  image          String?
  category       String?
  isAvailable    Boolean     @default(true)
  dietaryType    DietaryType @default(VEG)
  spicinessLevel Int         @default(0)
  prepTime       Int?
  calories       Int?
  allergens      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableNumber    String?       
  orderType      OrderType     @default(DINING)
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  paymentType    PaymentType   @default(POSTPAID)
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(PENDING_VERIFICATION)
  notes          String?       

  subtotal       Float
  tax            Float         @default(0)
  serviceFee     Float         @default(0)
  discount       Float         @default(0)
  totalAmount    Float

  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String?
  name        String
  price       Float
  quantity    Int
  itemTotal   Float
  notes       String?  
  createdAt   DateTime @default(now())
}

model SubscriptionPlan {
  id             String         @id @default(uuid())
  name           String
  code           String         @unique
  description    String?
  price          Float
  currency       String         @default("INR")
  interval       PlanInterval   @default(MONTHLY)
  features       String?
  maxStores      Int            @default(1)
  maxMenuItems   Int            @default(100)
  status         Status         @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subscriptions  StoreSubscription[]
}

model StoreSubscription {
  id                   String             @id @default(uuid())
  storeId              String
  store                Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime           @default(now())
  endDate              DateTime
  autoRenew            Boolean            @default(true)
  phonepeTxnId         String?            @unique
  phonepeMerchantTxnId String?            @unique
  amountPaid           Float
  paymentStatus        String             @default("SUCCESS")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}
