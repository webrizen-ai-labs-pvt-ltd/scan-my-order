{
  "expo": {
    "name": "Scan My Order - Staff POS",
    "slug": "staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "scanmyorderstaff",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logo.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.svg"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
